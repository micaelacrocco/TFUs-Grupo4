# Copiar a .env antes de levantar el stack: cp .env.example .env
# Son credenciales de demo para el Postgres local del docker-compose, no secretos reales.

POSTGRES_USER=investnow
POSTGRES_PASSWORD=investnow
POSTGRES_DB=investnow

DATABASE_URL=postgresql://investnow:investnow@postgres_db:5432/investnow

CATALOG_SERVICE_URL=http://catalog_service:8000
WALLET_SERVICE_URL=http://wallet_service:8000

JWT_SECRET_KEY="investnow_secret_jwt_key_tfu4_gatekeeper"